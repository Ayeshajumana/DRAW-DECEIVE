# DRAW & DECEIVE - Environment Configuration Template

# Django Configuration
DJANGO_SECRET_KEY=replace-with-a-random-secure-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Optional: defaults to SQLite for local development)
# DATABASE_URL=postgres://user:password@localhost:5432/draw_and_deceive

# Channel Layer / Redis Configuration (Optional: defaults to InMemoryChannelLayer for local single-process development)
# REDIS_URL=redis://127.0.0.1:6379/0

# Production Security
# DJANGO_SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
